parameters:
    treatPhpDocTypesAsCertain: false
    level: 10
    paths:
        - src
    tmpDir: /tmp/phpstan-generic-api
    reportAlwaysTrueInLastCondition: false
    ignoreErrors:
        - identifier: larastan.noEnvCallsOutsideOfConfig
        - identifier: match.alwaysTrue
        - identifier: booleanNot.alwaysTrue
    scanFiles:
        - phpstan-stubs/SymfonyFilesystem.stub
        - phpstan-stubs/Authenticable.stub
        - phpstan-stubs/AppUser.stub
        - phpstan-stubs/AppController.stub
        - phpstan-stubs/Sanctum.stub
    stubFiles:
        - phpstan-stubs/AppUserTypes.stub
includes:
    - vendor/larastan/larastan/extension.neon
