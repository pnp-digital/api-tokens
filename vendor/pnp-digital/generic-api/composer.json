{
    "name": "pnp-digital/generic-api",
    "description": "Laravel package for Generic API",
    "homepage": "https://github.com/pnp-digital/generic-api",
    "type": "library",
    "license": "All rights reserved",
    "keywords": [
        "laravel",
        "package",
        "assure",
        "ux",
        "pnp",
        "pnp-digital"
    ],
    "authors": [
        {
            "name": "Craig Edwards",
            "email": "craig@pipeandpiper.co.uk"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url":  "git@github.com:pnp-digital/generic-laravel-helpers.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url":  "git@github.com:pnp-digital/generic-mail.git",
            "no-api": true
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "league/fractal": "^0.20.1",
        "spatie/enum": "^3",
        "spatie/laravel-data": "^4",
        "spatie/laravel-typescript-transformer": "^2.5",
        "pnp-digital/generic-laravel-helpers": "^1.0",
        "pnp-digital/generic-mail": "^1.0"
    },
    "scripts": {
      "test": [
        "@putenv XDEBUG_MODE=coverage",
        "@php ./vendor/bin/phpunit --coverage-clover=tests/clover.xml -d --min-coverage=\"tests/coverage.php\""
      ],
      "lint": [
        "@php ./vendor/bin/phpstan"
      ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pipeandpiper\\API\\GenericApiProvider"
            ],
            "aliases": {
            }
        }
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "psr-4": {
            "Pipeandpiper\\API\\": "src/"
        }
    },
    "autoload-dev": {
      "psr-4": {
        "Tests\\": "tests/",
        "App\\": "tests/Fixtures/App/",
        "Typescript\\": "vendor/orchestra/testbench-core/laravel/storage/"
      }
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "phpunit/phpunit": "^11",
        "orchestra/testbench": "^11.3",
        "robiningelbrecht/phpunit-coverage-tools": "^1.10"
    }
}
